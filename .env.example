# Copie este arquivo para ".env" e preencha com os valores reais.
# NUNCA commite o arquivo ".env" (só este .env.example, sem valores) — ele já está
# protegido pelo .gitignore.

# ─── Banco de dados ────────────────────────────────────────────────────────────
# Se o projeto já roda no Replit, essa URL já existe nas variáveis de ambiente
# dele — copie de lá. Senão, crie um banco Postgres (o Replit tem 1 clique para isso).
# Se a separação de usuário de banco (lib/db/db-user-separation.sql) já foi aplicada,
# use aqui a credencial de RUNTIME (sem privilégio de DDL).
DATABASE_URL=
# Opcional — só necessário para rodar `pnpm --filter db run generate/migrate/push`
# depois da separação de usuário de banco: credencial com privilégio de DDL. Sem essa
# variável, os comandos de schema caem em DATABASE_URL (comportamento de antes).
MIGRATIONS_DATABASE_URL=

# ─── Autenticação (Clerk) ───────────────────────────────────────────────────────
# dashboard.clerk.com → seu projeto → API Keys
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Frontend (Vite) precisa da publishable key de novo, com o prefixo VITE_:
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
# Opcional — só se o projeto usar Clerk atrás de um proxy próprio:
VITE_CLERK_PROXY_URL=

# ─── Pagamentos (Stripe) ────────────────────────────────────────────────────────
# dashboard.stripe.com (modo de teste) → Developers → API Keys
STRIPE_SECRET_KEY=sk_test_...
# dashboard.stripe.com → Developers → Webhooks → seu endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── IA (OpenAI) ────────────────────────────────────────────────────────────────
# platform.openai.com → API Keys
AI_INTEGRATIONS_OPENAI_API_KEY=sk-...
# Deixe em branco para usar a API oficial da OpenAI (só preencha se usar um proxy/gateway):
AI_INTEGRATIONS_OPENAI_BASE_URL=

# ─── Admin / Superusuário ───────────────────────────────────────────────────────
# Clerk IDs (ex: user_abc123) separados por vírgula — contas que viram admin/superuser
# automaticamente no login. Pegue o seu Clerk ID em dashboard.clerk.com → Users.
ADMIN_CLERK_IDS=
SUPERUSER_CLERK_IDS=

# ─── App / CORS ─────────────────────────────────────────────────────────────────
# URL pública onde o app roda (usada em links de e-mail, redirect do Stripe, etc.)
APP_BASE_URL=http://localhost:5173
# Origens extras liberadas no CORS, separadas por vírgula (além de APP_BASE_URL).
# Deixe em branco em dev local — só é necessário se o front rodar em outra origem/porta.
CORS_ALLOWED_ORIGINS=

# ─── Frontend (Vite) — dev server ───────────────────────────────────────────────
PORT=5173
BASE_PATH=/
# Só necessário se você quiser testar a página pública compartilhada de demo:
VITE_DEMO_SHARE_ID=
# Número de WhatsApp exibido no botão flutuante (formato internacional, só dígitos):
VITE_WHATSAPP_NUMBER=

# ─── Outros ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
